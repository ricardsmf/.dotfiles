                                    {
                                        "set_variable": {
                                            "name": "hyper_tab_held_down",
                                            "value": 0
                                        }
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "tab" }],
                                "to_if_held_down": [
                                    {
                                        "set_variable": {
                                            "name": "hyper_tab_held_down",
                                            "value": 1
                                        }
                                    },
                                    {
                                        "key_code": "left_control",
                                        "modifiers": ["left_command"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
