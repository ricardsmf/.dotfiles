*/**/.undodir
home/.config/fish/fish_variables
home/.config/fish/conf.d/secrets.fish
home/.config/fish/conf.d/vault-funcs.fish
home/.config/opencode/amp_stuff/
.envrc
backups/
packages/failed_packages_*.txt
tmp/
.DS_Store


# Python
__pycache__/
*.pyc

# opencode
home/.config/opencode/node_modules/
home/.config/opencode/plugins/git-ai.ts
.opencode/plans/

# herdr runtime/state
home/.config/herdr/*.log
home/.config/herdr/session-history.json
home/.config/herdr/session.json
home/.config/herdr/release-notes.json

# pi agent — deny everything by default. ~/.pi/agent holds auth.json and
# models-store.json (credentials) plus sessions/ and npm/ (runtime state);
# only the config explicitly allowed at the bottom is tracked.
home/.pi/agent/*
home/.pi/todos/*
home/.pi/.pi/todos/*
.pi/todos/*

# pi secrets — listed explicitly so they stay ignored even if the
# allow-list below is ever widened. Keep new entries ABOVE that list.
home/.pi/agent/auth.json
home/.pi/agent/models-store.json
home/.pi/agent/mcp-oauth/
home/.pi/agent/mcp-cache.json
home/.pi/agent/mcp-npx-cache.json
home/.pi/agent/mcp-auth.json
home/.local/share/pi/mcp-auth.json

# pi extensions node_modules (if extensions are added back)
home/.pi/agent/extensions/**/node_modules/

# --- tracked pi config (negations must stay last) ---
!home/.pi/agent/settings.json
!home/.pi/agent/AGENTS.md

result
