                        "description": "rift: left option + digit -> control + option + digit (keeps right option free for @ and EUR)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "0",
                                    "modifiers": {
                                        "mandatory": ["left_option"],
                                        "optional": ["shift", "caps_lock"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "0",
                                        "modifiers": ["left_control", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "1",
                                    "modifiers": {
                                        "mandatory": ["left_option"],
                                        "optional": ["shift", "caps_lock"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "1",
                                        "modifiers": ["left_control", "left_option"]
                                    }
                                ],
